# --- Base de données ---
# En local (dev) : fichier relatif au projet. En Docker : file:/data/portfolio.db (défini dans docker-compose.yml)
DATABASE_URL="file:./prisma/dev.db"

# --- Sessions (nuxt-auth-utils) ---
# Clé de chiffrement des cookies de session scellés - 32 caractères minimum, à générer :
#   openssl rand -base64 32
NUXT_SESSION_PASSWORD=""

# --- Compte admin initial ---
# Créé automatiquement au premier démarrage si aucun utilisateur n'existe en base.
# L'administration se déverrouille avec le SEUL mot de passe ci-dessous : il n'y
# a pas d'identifiant à saisir. Choisissez-le long (20+ caractères), c'est
# l'unique secret qui protège l'admin :
#   openssl rand -base64 24
NUXT_ADMIN_PASSWORD=""

# Purement décoratifs (affichés dans l'interface d'admin), pas des identifiants.
NUXT_ADMIN_EMAIL="admin@local"
NUXT_ADMIN_NAME="Admin"

# --- SEO / URLs absolues (sitemap, Open Graph) ---
NUXT_PUBLIC_SITE_URL="http://localhost:8080"
