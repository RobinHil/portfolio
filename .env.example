# --- Base de données ---
# En local (dev) : fichier relatif au projet. En Docker : file:/data/portfolio.db (défini dans docker-compose.yml)
DATABASE_URL="file:./prisma/dev.db"

# --- Sessions (nuxt-auth-utils) ---
# Clé de chiffrement des cookies de session scellés - 32 caractères minimum, à générer :
#   openssl rand -base64 32
NUXT_SESSION_PASSWORD=""

# --- Compte admin initial ---
# Créé automatiquement au premier démarrage si aucun utilisateur n'existe en base.
NUXT_ADMIN_EMAIL="admin@example.com"
NUXT_ADMIN_PASSWORD="ChangeMe!42"
NUXT_ADMIN_NAME="Admin"

# --- SEO / URLs absolues (sitemap, Open Graph) ---
NUXT_PUBLIC_SITE_URL="http://localhost:8080"
